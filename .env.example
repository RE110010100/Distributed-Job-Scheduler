DJS_ENVIRONMENT=development
DJS_SHUTDOWN_TIMEOUT=10s
DJS_API_ADDRESS=:8080
DJS_DATABASE_URL=postgres://postgres:postgres@localhost:5432/djs?sslmode=disable
DJS_TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/djs?sslmode=disable

# Development-only internal-service credentials.
# Never commit production credentials.
DJS_INTERNAL_API_CREDENTIALS=example-service:change-me

# Worker control plane.
DJS_SCHEDULER_GRPC_ADDRESS=:9090
DJS_WORKER_HEARTBEAT_TIMEOUT=15s
DJS_WORKER_LIVENESS_CHECK_INTERVAL=5s
DJS_GRPC_RPC_TIMEOUT=5s

# Development only. Production secrets must not be committed.
DJS_WORKER_AUTH_TOKEN=change-me

# Worker process.
DJS_WORKER_ID=worker-1
DJS_SCHEDULER_ADDRESS=localhost:9090
DJS_WORKER_CPU_MILLIS=4000
DJS_WORKER_MEMORY_BYTES=8589934592